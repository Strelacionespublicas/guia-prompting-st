rules_version = '2';

// Cada alumno solo puede leer y escribir su propio documento (users/{su uid}).
// Las cuentas de la lista de admins pueden leer todos, para el panel de seguimiento.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['stellamaris.torres@gmail.com'];
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function validDoc() {
      let d = request.resource.data;
      return d.keys().hasOnly(['profile', 'progress', 'fields', 'stats', 'createdAt', 'updatedAt'])
        && (!('fields' in d) || (d.fields is map && d.fields.size() <= 1000))
        && (!('profile' in d) || d.profile is map)
        && (!('progress' in d) || d.progress is map)
        && (!('stats' in d) || d.stats is map);
    }

    // Contenido editable de la guía: lo leen todos, lo escribe solo la docente
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['blocks', 'videos', 'extras', 'updatedBy', 'updatedAt'])
        && request.resource.data.blocks is map
        && request.resource.data.videos is map
        && request.resource.data.extras is map;
    }

    // Certificados de finalización: cualquiera puede verificar uno por su código,
    // pero no listarlos. Solo lo registra el propio alumno, con los 17 capítulos terminados.
    match /certificates/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && (resource == null || resource.data.uid == request.auth.uid)
        && request.resource.data.keys().hasOnly(['uid', 'name', 'issuedAt', 'course'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && code.matches('ST-[A-Z0-9]{4}-[A-Z0-9]{4}')
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.progress.finishedCount >= 17;
      allow delete: if false;
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid) && validDoc();
      allow delete: if false;
    }
  }
}
